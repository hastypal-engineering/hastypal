package html

import "github.com/adriein/hastypal/internal/web"

templ Error(dto *web.ErrorDTO) {
	<html>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<title>500 - Something Went Wrong</title>
			<style>
				:root {
					--bg-color: #fdf6f6;
					--card-bg: #ffffff;
					--primary-pink: #ff6b81;
					--accent-pink: #ff8597;
					--text-dark: #2d3436;
					--text-muted: #636e72;
					--shadow: 0 10px 30px rgba(255, 107, 129, 0.15);
				}

				* {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				body {
					font-family:
						-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
						Arial, sans-serif;
					background-color: var(--bg-color);
					color: var(--text-dark);
					display: flex;
					align-items: center;
					justify-content: center;
					min-height: 100vh;
					padding: 20px;
				}

				.error-card {
					background: var(--card-bg);
					padding: 40px 30px;
					border-radius: 24px;
					box-shadow: var(--shadow);
					text-align: center;
					max-width: 480px;
					width: 100%;
					border: 2px solid #ffeef0;
				}

				.logo-wrapper {
					margin-bottom: 24px;
					display: inline-block;
					animation: float 3s ease-in-out infinite;
				}

				.logo-wrapper img {
					width: 120px;
					height: 120px;
					object-fit: contain;
				}

				.error-code {
					font-size: 0.9rem;
					font-weight: 700;
					color: var(--primary-pink);
					text-transform: uppercase;
					letter-spacing: 2px;
					margin-bottom: 8px;
				}

				h1 {
					font-size: 1.8rem;
					color: var(--text-dark);
					margin-bottom: 12px;
					font-weight: 700;
				}

				p {
					color: var(--text-muted);
					font-size: 1rem;
					line-height: 1.6;
					margin-bottom: 28px;
				}

				.actions {
					display: flex;
					gap: 12px;
					justify-content: center;
					flex-wrap: wrap;
				}

				.btn {
					display: inline-block;
					padding: 12px 24px;
					border-radius: 12px;
					font-size: 0.95rem;
					font-weight: 600;
					text-decoration: none;
					transition: all 0.2s ease;
					cursor: pointer;
				}

				.btn-primary {
					background-color: var(--primary-pink);
					color: #ffffff;
					box-shadow: 0 4px 12px rgba(255, 107, 129, 0.3);
				}

				.btn-primary:hover {
					background-color: var(--accent-pink);
					transform: translateY(-2px);
				}

				.btn-secondary {
					background-color: #f1f2f6;
					color: var(--text-dark);
				}

				.btn-secondary:hover {
					background-color: #e4e7eb;
					transform: translateY(-2px);
				}

				@keyframes float {
					0%,
					100% {
						transform: translateY(0);
					}
					50% {
						transform: translateY(-10px);
					}
				}
			</style>
			<link rel="icon" type="image/x-icon" href="/ui/static/images/golden_helmet.ico"/>
			<link rel="stylesheet" href="/ui/static/css/main.css"/>
		</head>
		<body>
			<div class="error-card">
				<div class="logo-wrapper">
					<img src="/ui/static/images/hastypal_crab.png" alt="Hastypal Crab Logo"/>
				</div>
				<div class="error-code">Error 500</div>
				<h1>Looks like we pinched a wire!</h1>
				<p>Something went wrong on our end. Don't worry, our team has been notified and we're working to snap things back into place.</p>
				<div class="actions">
					<a href="/" class="btn btn-primary">Take Me Home</a>
					<button onclick="window.location.reload()" class="btn btn-secondary">Try Again</button>
				</div>
			</div>
		</body>
	</html>
}
